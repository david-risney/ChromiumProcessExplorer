<Window x:Class="ChromiumProcessExplorer.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChromiumProcessExplorer.Gui"
        Title="Chromium Process Explorer"
        Icon="Assets/ChromiumProcessExplorer.ico"
        Width="1360"
        Height="860"
        MinWidth="980"
        MinHeight="640"
        Background="#FFF5F6F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="SectionCard" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFD8DDE6" />
        </Style>
        <DataTemplate x:Key="PropertyRowTemplate" DataType="{x:Type local:PropertyRow}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                <TextBox Grid.Column="1"
                         Padding="0"
                         BorderThickness="0"
                         Background="Transparent"
                         IsReadOnly="True"
                         Text="{Binding Value, Mode=OneWay}"
                         TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#FFE1E5EB" />
            <Setter Property="VerticalGridLinesBrush" Value="#FFE1E5EB" />
            <Setter Property="BorderBrush" Value="#FFD8DDE6" />
            <Setter Property="Background" Value="White" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <DataTemplate x:Key="NoticeTemplate"
                      DataType="{x:Type local:ContextIssueViewModel}">
            <Border Margin="0,2,0,0"
                    Padding="8,5"
                    Background="#FFFFF7DF"
                    BorderBrush="#FFE5C365"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding Message}"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1"
                            Width="24"
                            Height="24"
                            Margin="8,0,0,0"
                            Padding="0"
                            Click="DismissNotice_Click"
                            Tag="{Binding}"
                            ToolTip="Dismiss this warning">
                        <Path Width="10"
                              Height="10"
                              Data="M1,1 L9,9 M9,1 L1,9"
                              Stroke="#FF5B6472"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <TabControl Margin="8">
            <TabItem Header="Processes">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390" MinWidth="280" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" MinWidth="480" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.ColumnSpan="3"
                            Margin="0,0,0,8"
                            Padding="8"
                            Background="White"
                            BorderBrush="#FFD8DDE6"
                            BorderThickness="1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left"
                                        Orientation="Horizontal">
                                <Button Click="RefreshProcesses_Click"
                                        Padding="12,4"
                                        Content="Refresh">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProcessActivityBusy}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Margin="6,0,0,0"
                                        Click="CancelProcessRefresh_Click"
                                        Padding="12,4"
                                        Content="Cancel"
                                        ToolTip="Stop the current process refresh">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRefreshingProcesses}" Value="True">
                                                    <Setter Property="IsEnabled" Value="True" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <CheckBox Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          Content="Auto refresh"
                                          IsChecked="{Binding AutoRefreshProcesses}"
                                          ToolTip="Poll Mojo pipe names and run a full refresh only when they change." />
                                <ProgressBar Width="90"
                                             Height="6"
                                             Margin="10,0,0,0"
                                             VerticalAlignment="Center"
                                             IsIndeterminate="True">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProcessActivityBusy}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                            </StackPanel>
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#FF5B6472"
                                       Text="{Binding Status}" />
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="White"
                                    BorderBrush="#FFB8C0CC"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Width="14"
                                          Height="14"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M6.5,1 A5.5,5.5 0 1 0 6.5,12 A5.5,5.5 0 1 0 6.5,1 M10.5,10.5 L15,15"
                                          Stroke="#FF7A8491"
                                          StrokeThickness="1.5" />
                                    <Grid Grid.Column="1">
                                        <TextBlock Margin="1,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#FF929AA5"
                                                   IsHitTestVisible="False"
                                                   Text="Filter processes">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProcessFilter}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Padding="0,5"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Filter by process name, PID, platform, or role" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Button Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Click="ToggleProcessExpansion_Click"
                                    Padding="9,4"
                                    Content="{Binding ProcessExpansionButtonText}" />
                        </Grid>
                        <TreeView Grid.Row="1"
                                  ItemsSource="{Binding FilteredProcessRoots}"
                                  SelectedItemChanged="ProcessTree_SelectedItemChanged"
                                  Background="White"
                                  BorderBrush="#FFD8DDE6">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded"
                                            Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected"
                                            Value="{Binding IsSelected, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type local:ProcessTreeItemViewModel}"
                                                          ItemsSource="{Binding Children}">
                                    <Grid Margin="1">
                                        <Grid.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                         Opened="ProcessContextMenu_Opened">
                                                <MenuItem Header="Copy"
                                                          Click="CopyProcess_Click" />
                                                <MenuItem Header="Copy Details"
                                                          Click="CopyProcessDetails_Click" />
                                                <Separator />
                                                <MenuItem Header="Debug"
                                                          Click="DebugProcess_Click" />
                                                <MenuItem Header="Debug Future Launches"
                                                          Click="DebugFutureProcess_Click" />
                                                <MenuItem Header="Process Explorer"
                                                          Click="OpenProcessExplorer_Click" />
                                                <Separator />
                                                <MenuItem Header="Relaunch with Template"
                                                          Tag="command-templates" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Opacity" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStale}" Value="True">
                                                        <Setter Property="Opacity" Value="0.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Width="18"
                                               Height="18"
                                               Source="{Binding Icon}"
                                               Stretch="Uniform" />
                                        <StackPanel Grid.Column="1"
                                                    Margin="4,0,8,0"
                                                    Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding ImageName}" />
                                            <TextBlock Margin="5,0,0,0"
                                                       Text="{Binding ProcessId, StringFormat=({0})}" />
                                            <TextBlock Margin="6,0,0,0"
                                                       Foreground="#FF806000"
                                                       Text="{Binding ReferenceLabel}" />
                                            <TextBlock Margin="6,0,0,0"
                                                       Foreground="#FFA12622"
                                                       Text="{Binding StateLabel}" />
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                Margin="0,0,5,0"
                                                Padding="5,1"
                                                Background="{Binding PlatformBadgeBackground}"
                                                CornerRadius="3">
                                            <TextBlock FontSize="11"
                                                       Foreground="{Binding PlatformBadgeForeground}"
                                                       Text="{Binding Platform}" />
                                        </Border>
                                        <Border Grid.Column="3"
                                                Margin="0,0,5,0"
                                                Padding="5,1"
                                                Background="{Binding RoleBadgeBackground}"
                                                CornerRadius="3">
                                            <TextBlock FontSize="11"
                                                       Foreground="{Binding RoleBadgeForeground}"
                                                       Text="{Binding Role}" />
                                        </Border>
                                        <TextBlock Grid.Column="4"
                                                   Foreground="#FFD13438"
                                                   FontWeight="Bold"
                                                   Text="!"
                                                   Visibility="{Binding HasWarning, Converter={StaticResource BooleanToVisibility}}" />
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </Grid>

                    <GridSplitter Grid.Row="1"
                                  Grid.Column="1"
                                  Width="5"
                                  HorizontalAlignment="Stretch"
                                  Background="#FFE1E5EB" />

                    <Grid Grid.Row="1"
                          Grid.Column="2"
                          Margin="12,0,0,0">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   Foreground="#FF6A7380"
                                   Text="Select a Chromium or host process to inspect it.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProcessInspector}"
                                                     Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProcessInspector}"
                                                     Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel DataContext="{Binding ProcessInspector}">
                                <Border Margin="0,0,0,12"
                                        Padding="14"
                                        Background="White"
                                        BorderBrush="#FFD8DDE6"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Width="32"
                                               Height="32"
                                               Source="{Binding Icon}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="22"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding ImageName}" />
                                            <TextBlock Foreground="#FF5B6472">
                                                <Run Text="{Binding Platform}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Role}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <GroupBox Header="Summary" Style="{StaticResource SectionCard}">
                                    <ItemsControl ItemTemplate="{StaticResource PropertyRowTemplate}"
                                                  ItemsSource="{Binding Summary}" />
                                </GroupBox>
                                <GroupBox Header="Runtime classification" Style="{StaticResource SectionCard}">
                                    <ItemsControl ItemTemplate="{StaticResource PropertyRowTemplate}"
                                                  ItemsSource="{Binding Runtime}" />
                                </GroupBox>
                                <GroupBox Header="Executable and security" Style="{StaticResource SectionCard}">
                                    <ItemsControl ItemTemplate="{StaticResource PropertyRowTemplate}"
                                                  ItemsSource="{Binding Executable}" />
                                </GroupBox>
                                <GroupBox Header="Command line" Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBox Padding="6"
                                                 FontFamily="Consolas"
                                                 IsReadOnly="True"
                                                 Text="{Binding CommandLine, Mode=OneWay}"
                                                 TextWrapping="Wrap" />
                                        <DataGrid Margin="0,8,0,0" ItemsSource="{Binding Switches}" MaxHeight="240">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Switch" Binding="{Binding Name}" Width="*" />
                                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="3*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="Paths" Style="{StaticResource SectionCard}">
                                    <DataGrid ItemsSource="{Binding Paths}" MaxHeight="260">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="*" />
                                            <DataGridTextColumn Header="Location" Binding="{Binding Value}" Width="3*" />
                                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*" />
                                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </GroupBox>
                                <GroupBox Header="DevTools and diagnostics" Style="{StaticResource SectionCard}">
                                    <DataGrid ItemsSource="{Binding Diagnostics}" MaxHeight="260">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="*" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="2*" />
                                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </GroupBox>
                                <Expander Margin="0,0,0,12"
                                          Header="Additional Information"
                                          IsExpanded="False">
                                    <StackPanel Margin="0,8,0,0">
                                        <GroupBox Header="Relationships" Style="{StaticResource SectionCard}">
                                            <DataGrid ItemsSource="{Binding Relationships}" MaxHeight="230">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" />
                                                    <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="*" />
                                                    <DataGridTextColumn Header="Relationship" Binding="{Binding Relationship}" Width="*" />
                                                    <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" />
                                                    <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="2*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </GroupBox>
                                        <GroupBox Header="Evidence" Style="{StaticResource SectionCard}">
                                            <DataGrid ItemsSource="{Binding Evidence}" MaxHeight="260">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*" />
                                                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*" />
                                                    <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </GroupBox>
                                        <GroupBox Header="Access and discovery issues" Style="{StaticResource SectionCard}">
                                            <ItemsControl ItemsSource="{Binding Issues}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,3"
                                                                Padding="8"
                                                                Background="#FFFFECEC">
                                                            <TextBlock Text="{Binding Message}"
                                                                       TextWrapping="Wrap" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </GroupBox>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <ItemsControl Grid.Row="2"
                                  Grid.ColumnSpan="3"
                                  Margin="0,8,0,0"
                                  MaxHeight="100"
                                  ItemTemplate="{StaticResource NoticeTemplate}"
                                  ItemsSource="{Binding ProcessNotices}" />
                </Grid>
            </TabItem>

            <TabItem Header="Installs">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="760" MinWidth="420" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" MinWidth="320" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="3"
                            Margin="0,0,0,8"
                            Padding="8"
                            Background="White"
                            BorderBrush="#FFD8DDE6"
                            BorderThickness="1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left"
                                        Orientation="Horizontal">
                                <Button Click="RefreshInstallations_Click"
                                        Padding="12,4"
                                        Content="Refresh">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScanningInstallations}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Margin="6,0,0,0"
                                        Click="CancelInstallationScan_Click"
                                        Padding="12,4"
                                        Content="Cancel"
                                        ToolTip="Stop the current installation scan">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScanningInstallations}" Value="True">
                                                    <Setter Property="IsEnabled" Value="True" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <ProgressBar Width="90"
                                             Height="6"
                                             Margin="10,0,0,0"
                                             VerticalAlignment="Center"
                                             IsIndeterminate="True">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScanningInstallations}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                            </StackPanel>
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#FF5B6472"
                                       Text="{Binding InstallationStatus}" />
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                                Margin="0,0,0,8"
                                Background="White"
                                BorderBrush="#FFB8C0CC"
                                BorderThickness="1"
                                CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Width="14"
                                      Height="14"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M6.5,1 A5.5,5.5 0 1 0 6.5,12 A5.5,5.5 0 1 0 6.5,1 M10.5,10.5 L15,15"
                                      Stroke="#FF7A8491"
                                      StrokeThickness="1.5" />
                                <Grid Grid.Column="1">
                                    <TextBlock Margin="1,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="#FF929AA5"
                                               IsHitTestVisible="False"
                                               Text="Filter installations">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InstallationFilter}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Padding="0,5"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Text="{Binding InstallationFilter, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Filter by name, platform, kind, version, channel, or path" />
                                </Grid>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1">
                            <DataGrid ItemsSource="{Binding FilteredInstallations}"
                                      PreviewMouseRightButtonDown="Installations_PreviewMouseRightButtonDown"
                                      SelectedItem="{Binding SelectedInstallation}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      Sorting="Installations_Sorting">
                                <DataGrid.ContextMenu>
                                    <ContextMenu Opened="InstallationContextMenu_Opened">
                                        <MenuItem Header="Copy"
                                                  Click="CopyInstallation_Click"
                                                  Tag="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Copy Details"
                                                  Click="CopyInstallationDetails_Click"
                                                  Tag="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem Header="Debug Future Launches"
                                                  Click="DebugFutureInstallation_Click"
                                                  Tag="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem Header="Launch with Template"
                                                  Tag="command-templates" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="34" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image Width="20"
                                                       Height="20"
                                                       Source="{Binding Icon}"
                                                       Stretch="Uniform" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                                    <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" />
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" />
                                    <DataGridTextColumn Header="Version"
                                                        Binding="{Binding Version}"
                                                        SortMemberPath="Version"
                                                        Width="145" />
                                    <DataGridTextColumn Header="Channel"
                                                        Binding="{Binding Channel}"
                                                        SortMemberPath="Channel" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                    <GridSplitter Grid.Row="1"
                                  Grid.Column="1"
                                  Width="5"
                                  Background="#FFE1E5EB" />
                    <Grid Grid.Row="1"
                          Grid.Column="2"
                          Margin="12,0,0,0">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   Foreground="#FF6A7380"
                                   Text="Select an install to inspect it.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedInstallation}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedInstallation}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel>
                                <GroupBox Header="Selected installation" Style="{StaticResource SectionCard}">
                                    <ItemsControl ItemTemplate="{StaticResource PropertyRowTemplate}"
                                                  ItemsSource="{Binding SelectedInstallation.Details}" />
                                </GroupBox>
                                <GroupBox Header="Discovery evidence" Style="{StaticResource SectionCard}">
                                    <DataGrid ItemsSource="{Binding SelectedInstallation.Evidence}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*" />
                                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <ItemsControl Grid.Row="2"
                                  Grid.ColumnSpan="3"
                                  Margin="0,8,0,0"
                                  MaxHeight="100"
                                  ItemTemplate="{StaticResource NoticeTemplate}"
                                  ItemsSource="{Binding InstallationNotices}" />
                </Grid>
            </TabItem>

            <TabItem Header="DevTools">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ItemsControl ItemsSource="{Binding DevToolsNotices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="5"
                                               Foreground="#FFA12622"
                                               Text="{Binding Message}"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding DevTools}"
                                  SelectedItem="{Binding SelectedDevTools}"
                                  SelectionChanged="DevTools_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" />
                                <DataGridTextColumn Header="Availability" Binding="{Binding Availability}" Width="2*" />
                                <DataGridTextColumn Header="Transport" Binding="{Binding TransportLabel}" Width="*" />
                                <DataGridTextColumn Header="Browser" Binding="{Binding Browser}" Width="2*" />
                                <DataGridTextColumn Header="Restriction or error" Binding="{Binding Error}" Width="3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <GridSplitter Grid.Column="1" Width="5" Background="#FFE1E5EB" />
                    <ScrollViewer Grid.Column="2"
                                  Margin="12,0,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <GroupBox Header="Selected DevTools endpoint" Style="{StaticResource SectionCard}">
                            <ItemsControl ItemTemplate="{StaticResource PropertyRowTemplate}"
                                          ItemsSource="{Binding SelectedDevTools.Details}" />
                        </GroupBox>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Command Line Templates">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" MinWidth="240" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" MinWidth="420" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,8"
                                    Orientation="Horizontal">
                            <Button Padding="12,4"
                                    Click="AddCommandLineTemplate_Click"
                                    Content="Add" />
                            <Button Margin="6,0,0,0"
                                    Padding="12,4"
                                    Click="RemoveCommandLineTemplate_Click"
                                    Content="Remove" />
                        </StackPanel>
                        <ListBox Grid.Row="1"
                                 DisplayMemberPath="Name"
                                 ItemsSource="{Binding CommandLineTemplates}"
                                 SelectedItem="{Binding SelectedCommandLineTemplate}" />
                    </Grid>
                    <GridSplitter Grid.Column="1"
                                  Width="5"
                                  Background="#FFE1E5EB" />
                    <Grid Grid.Column="2"
                          Margin="12,0,0,0">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   Foreground="#FF6A7380"
                                   Text="Add or select a command line template.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCommandLineTemplate}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCommandLineTemplate}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel DataContext="{Binding SelectedCommandLineTemplate}">
                                <GroupBox Header="Template"
                                          Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="Name" />
                                        <TextBox Margin="0,5,0,12"
                                                 Padding="6"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="Applicable executable regex" />
                                        <TextBlock Margin="0,2,0,5"
                                                   Foreground="#FF5B6472"
                                                   Text="Matched against the executable file name. The default .* matches every executable." />
                                        <TextBox Padding="6"
                                                 FontFamily="Consolas"
                                                 Text="{Binding ApplicableExecutableRegex, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="Command line parts to add"
                                          Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Foreground="#FF5B6472"
                                                   Text="Enter one complete argument per line, such as --remote-debugging-port=9222."
                                                   TextWrapping="Wrap" />
                                        <TextBox MinHeight="130"
                                                 Margin="0,8,0,0"
                                                 Padding="6"
                                                 AcceptsReturn="True"
                                                 FontFamily="Consolas"
                                                 Text="{Binding AddPartsText, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalScrollBarVisibility="Auto" />
                                        <Separator Margin="0,12,0,10" />
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="Find Chromium arguments" />
                                        <TextBlock Margin="0,2,0,5"
                                                   Foreground="#FF5B6472"
                                                   Text="Search the generated Chromium catalog and arguments observed on currently running processes."
                                                   TextWrapping="Wrap" />
                                        <TextBox Padding="6"
                                                 Text="{Binding DataContext.CommandLineSuggestionFilter, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Search switch names, feature names, and descriptions" />
                                        <DataGrid Height="230"
                                                  Margin="0,8,0,0"
                                                  ItemsSource="{Binding DataContext.FilteredCommandLineSuggestions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  MouseDoubleClick="CommandLineSuggestion_MouseDoubleClick"
                                                  SelectedItem="{Binding DataContext.SelectedCommandLineSuggestion, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Argument"
                                                                    Binding="{Binding Argument}"
                                                                    Width="2*" />
                                                <DataGridTextColumn Header="Type"
                                                                    Binding="{Binding Kind}" />
                                                <DataGridTextColumn Header="Origin"
                                                                    Binding="{Binding Origin}" />
                                                <DataGridTextColumn Header="Description"
                                                                    Binding="{Binding Description}"
                                                                    Width="3*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <DockPanel Margin="0,8,0,0">
                                            <Button DockPanel.Dock="Right"
                                                    Padding="12,4"
                                                    Click="AddCommandLineSuggestion_Click"
                                                    Content="Add selected argument" />
                                            <TextBlock VerticalAlignment="Center"
                                                       Foreground="#FF5B6472"
                                                       Text="{Binding DataContext.CommandLineSuggestionStatus, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </DockPanel>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="Command line parts to remove"
                                          Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <TextBlock Foreground="#FF5B6472"
                                                   Text="Enter one argument or switch per line. Prefix a regular expression with regex:. A switch without = removes that switch with any value."
                                                   TextWrapping="Wrap" />
                                        <TextBox MinHeight="130"
                                                 Margin="0,8,0,0"
                                                 Padding="6"
                                                 AcceptsReturn="True"
                                                 FontFamily="Consolas"
                                                 Text="{Binding RemovePartsText, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                </GroupBox>
                                <Border Padding="8"
                                        Background="#FFFFECEC">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ValidationError}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ValidationError}"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer Margin="4"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900"
                                HorizontalAlignment="Left">
                        <Border Margin="0,0,0,12"
                                Padding="18"
                                Background="White"
                                BorderBrush="#FFD8DDE6"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Width="72"
                                       Height="72"
                                       Source="Assets/ChromiumProcessExplorer.png" />
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock FontSize="24"
                                               FontWeight="SemiBold"
                                               Text="{Binding ProductName}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="#FF5B6472"
                                               Text="{Binding ProductVersion, StringFormat=Version {0}}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <GroupBox Header="Process refresh"
                                  Style="{StaticResource SectionCard}">
                            <CheckBox Content="Automatically refresh when the Mojo pipe set changes"
                                      IsChecked="{Binding AutoRefreshProcesses}" />
                        </GroupBox>

                        <GroupBox Header="External debugging tools"
                                  Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="Debug command" />
                                <TextBlock Margin="0,2,0,5"
                                           Foreground="#FF5B6472"
                                           Text="Use {pid} where the selected process ID should be inserted." />
                                <TextBox Padding="6"
                                         FontFamily="Consolas"
                                         Text="{Binding DebugCommand, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Margin="0,14,0,0"
                                           FontWeight="SemiBold"
                                           Text="Future-launch debugger command" />
                                <TextBlock Margin="0,2,0,5"
                                           Foreground="#FF5B6472"
                                           TextWrapping="Wrap"
                                           Text="Stored in Image File Execution Options for desktop executables, or passed to PLMDebug for packaged apps." />
                                <TextBox Padding="6"
                                         FontFamily="Consolas"
                                         Text="{Binding FutureDebuggerCommand, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Margin="0,14,0,0"
                                           FontWeight="SemiBold"
                                           Text="Process Explorer command" />
                                <TextBlock Margin="0,2,0,5"
                                           Foreground="#FF5B6472"
                                           Text="Use {pid} where the selected process ID should be inserted." />
                                <TextBox Padding="6"
                                         FontFamily="Consolas"
                                         Text="{Binding ProcessExplorerCommand, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Installation discovery"
                                  Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Foreground="#FF5B6472"
                                           Text="Additional folders to scan, one full path per line. Default Windows installation locations are still included."
                                           TextWrapping="Wrap" />
                                <TextBox MinHeight="110"
                                         Margin="0,8,0,0"
                                         Padding="6"
                                         AcceptsReturn="True"
                                         FontFamily="Consolas"
                                         Text="{Binding AdditionalInstallationFoldersText, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </GroupBox>

                        <TextBlock Margin="4,0,4,12"
                                   Foreground="#FF5B6472"
                                   Text="{Binding SettingsStatus}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
