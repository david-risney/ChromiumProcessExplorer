<Window x:Class="ChromiumProcessExplorer.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChromiumProcessExplorer.Gui"
        Title="Chromium Process Explorer"
        Width="1280"
        Height="820"
        MinWidth="900"
        MinHeight="600">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Button Click="RefreshProcesses_Click"
                    Padding="10,3"
                    Content="Refresh processes" />
            <Button Click="RefreshInstallations_Click"
                    Padding="10,3"
                    Content="Scan installations" />
            <Button Click="ProbeBroker_Click"
                    Padding="10,3"
                    Content="Check broker" />
            <Button Click="Cancel_Click"
                    Padding="10,3"
                    Content="Cancel" />
            <Separator />
            <Button Click="Export_Click"
                    Padding="10,3"
                    Content="Export JSON" />
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding BrokerStatus, StringFormat=Broker: {0}}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding IsBusy, StringFormat=Busy: {0}}" />
            </StatusBarItem>
        </StatusBar>

        <TabControl>
            <TabItem Header="Process graph">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="3*" />
                    </Grid.RowDefinitions>
                    <GroupBox Header="Processes (one row per process generation)"
                              Margin="6">
                        <DataGrid ItemsSource="{Binding Processes}"
                                  SelectedItem="{Binding SelectedProcess}"
                                  SelectionChanged="ProcessSelection_Changed"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PID"
                                                    Binding="{Binding ProcessId}" />
                                <DataGridTextColumn Header="Image"
                                                    Binding="{Binding ImageName}"
                                                    Width="2*" />
                                <DataGridTextColumn Header="Role"
                                                    Binding="{Binding Role}"
                                                    Width="2*" />
                                <DataGridTextColumn Header="Parent PID"
                                                    Binding="{Binding ParentProcessId}" />
                                <DataGridTextColumn Header="State"
                                                    Binding="{Binding State}" />
                                <DataGridTextColumn Header="Evidence"
                                                    Binding="{Binding Evidence}"
                                                    Width="4*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <GroupBox Grid.Row="1"
                              Header="Typed relationships (logical edges do not duplicate nodes)"
                              Margin="6">
                        <DataGrid ItemsSource="{Binding Relationships}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="From"
                                                    Binding="{Binding Source}"
                                                    Width="*" />
                                <DataGridTextColumn Header="From PID"
                                                    Binding="{Binding SourceProcessId}" />
                                <DataGridTextColumn Header="To"
                                                    Binding="{Binding Target}"
                                                    Width="*" />
                                <DataGridTextColumn Header="To PID"
                                                    Binding="{Binding TargetProcessId}" />
                                <DataGridTextColumn Header="Relationship"
                                                    Binding="{Binding Relationship}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Edge class"
                                                    Binding="{Binding EdgeClass}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Confidence"
                                                    Binding="{Binding Confidence}" />
                                <DataGridTextColumn Header="Evidence"
                                                    Binding="{Binding Evidence}"
                                                    Width="3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="OS process tree">
                <TreeView ItemsSource="{Binding ProcessTree}"
                          Margin="8">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type local:ProcessTreeRow}"
                                                  ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding DisplayName}" />
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </TabItem>

            <TabItem Header="Process details">
                <TextBox Text="{Binding SelectedProcessDetails, Mode=OneWay}"
                         Margin="8"
                         FontFamily="Consolas"
                         FontSize="13"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </TabItem>

            <TabItem Header="Mojo">
                <DataGrid ItemsSource="{Binding MojoPipes}"
                          Margin="6"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pipe"
                                            Binding="{Binding PipeName}"
                                            Width="3*" />
                        <DataGridTextColumn Header="Server"
                                            Binding="{Binding Server}"
                                            Width="*" />
                        <DataGridTextColumn Header="Server PID"
                                            Binding="{Binding ServerProcessId}" />
                        <DataGridTextColumn Header="Client"
                                            Binding="{Binding Client}"
                                            Width="*" />
                        <DataGridTextColumn Header="Client PID"
                                            Binding="{Binding ClientProcessId}" />
                        <DataGridTextColumn Header="State"
                                            Binding="{Binding State}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="CDP">
                <DataGrid ItemsSource="{Binding CdpTransports}"
                          Margin="6"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PID"
                                            Binding="{Binding ProcessId}" />
                        <DataGridTextColumn Header="Kind"
                                            Binding="{Binding Kind}" />
                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}" />
                        <DataGridTextColumn Header="Port"
                                            Binding="{Binding Port}" />
                        <DataGridTextColumn Header="Browser"
                                            Binding="{Binding Browser}"
                                            Width="2*" />
                        <DataGridTextColumn Header="Restriction"
                                            Binding="{Binding Restriction}"
                                            Width="2*" />
                        <DataGridTextColumn Header="Error"
                                            Binding="{Binding Error}"
                                            Width="3*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Installations">
                <DataGrid ItemsSource="{Binding Installations}"
                          Margin="6"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"
                                            Binding="{Binding Name}"
                                            Width="2*" />
                        <DataGridTextColumn Header="Platform"
                                            Binding="{Binding Platform}" />
                        <DataGridTextColumn Header="Kind"
                                            Binding="{Binding Kind}" />
                        <DataGridTextColumn Header="Version"
                                            Binding="{Binding Version}" />
                        <DataGridTextColumn Header="Channel"
                                            Binding="{Binding Channel}" />
                        <DataGridTextColumn Header="Install type"
                                            Binding="{Binding InstallType}" />
                        <DataGridTextColumn Header="Confidence"
                                            Binding="{Binding Confidence}" />
                        <DataGridTextColumn Header="Path"
                                            Binding="{Binding InstallPath}"
                                            Width="4*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Issues / partial coverage">
                <DataGrid ItemsSource="{Binding Issues}"
                          Margin="6"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Source"
                                            Binding="{Binding Source}"
                                            Width="2*" />
                        <DataGridTextColumn Header="PID"
                                            Binding="{Binding ProcessId}" />
                        <DataGridTextColumn Header="Message"
                                            Binding="{Binding Message}"
                                            Width="6*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="JSON">
                <TextBox Text="{Binding JsonText, Mode=OneWay}"
                         Margin="8"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
